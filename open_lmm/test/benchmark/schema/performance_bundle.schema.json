{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-lmm.invalid/schema/performance_bundle-v1.json",
  "title": "OpenLMM aggregate performance bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "profile", "scenario", "key",
    "reports", "metrics", "baseline", "comparisons", "comparison",
    "failures"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "median", "p95", "mad", "min", "max"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "median": {"type": "number", "minimum": 0},
        "p95": {"type": ["integer", "null"], "minimum": 0},
        "mad": {"type": "number", "minimum": 0},
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "profile": {
      "enum": ["contract", "pr", "nightly", "external", "gpu"]
    },
    "scenario": {
      "enum": [
        "open", "data-load", "alignment", "map-update-sequential",
        "map-update-parallel", "save-fallback", "visualization-cold",
        "visualization-warm", "full-pipeline", "cancellation"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_schema", "measurement_role", "fixture_id", "fixture_manifest_sha256",
        "scenario", "compiler", "build_type", "sanitizer", "cpu_model",
        "cpu_count", "memory_class", "container_digest", "plugin_ids",
        "config_fingerprint", "pair_fingerprint", "parallelism"
      ],
      "properties": {
        "report_schema": {"const": 1},
        "measurement_role": {"enum": ["public", "owner"]},
        "fixture_id": {"type": "string", "minLength": 1},
        "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "scenario": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "build_type": {"type": "string", "minLength": 1},
        "sanitizer": {"type": "string", "minLength": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "cpu_count": {"type": "integer", "minimum": 1},
        "memory_class": {"type": "string", "minLength": 1},
        "container_digest": {"$ref": "#/$defs/sha256"},
        "plugin_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "config_fingerprint": {"$ref": "#/$defs/sha256"},
        "pair_fingerprint": {"$ref": "#/$defs/sha256"},
        "parallelism": {
          "enum": ["map-update-disabled", "sequential", "parallel"]
        }
      }
    },
    "reports": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "run_id", "iteration", "result"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "run_id": {"type": "string", "minLength": 1},
          "iteration": {"type": "integer", "minimum": 1},
          "result": {
            "enum": ["pass", "fail", "uncalibrated", "not_available", "invalid"]
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "summary"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "summary": {"$ref": "#/$defs/summary"}
        }
      }
    },
    "baseline": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "id"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "name", "statistic", "expected", "actual", "allowance", "delta",
          "result"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "statistic": {"enum": ["median", "p95", "mad", "min", "max"]},
          "expected": {"type": "number", "minimum": 0},
          "actual": {"type": "number", "minimum": 0},
          "allowance": {"type": "number", "minimum": 0},
          "delta": {"type": "number"},
          "result": {"enum": ["pass", "fail"]}
        }
      }
    },
    "comparison": {
      "enum": ["pass", "fail", "uncalibrated", "baseline_mismatch"]
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "message"],
        "properties": {
          "phase": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
