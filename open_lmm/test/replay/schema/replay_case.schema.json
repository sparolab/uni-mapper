{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-lmm.org/schemas/replay-case-v1.json",
  "title": "OpenLMM replay case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "tier", "dataset", "provenance",
    "config", "workflow", "expected", "tolerances"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "tier": {"enum": ["tiny", "small", "representative", "failure"]},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id", "bundle_sha256", "source", "license",
        "redistributable", "agents"
      ],
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "redistributable": {"type": "boolean"},
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "frames", "pose_file", "scan_index"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "frames": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "integer", "minimum": 0}
              },
              "pose_file": {"$ref": "#/$defs/file_lock"},
              "scan_index": {"$ref": "#/$defs/file_lock"}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquired_at", "source_version", "attribution_file",
        "transformations", "original_sha256"
      ],
      "properties": {
        "acquired_at": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "attribution_file": {"$ref": "#/$defs/relative_path"},
        "transformations": {
          "type": "array", "items": {"type": "string", "minLength": 1}
        },
        "original_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "files", "plugins"],
      "properties": {
        "root": {"$ref": "#/$defs/relative_path"},
        "files": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/file_lock"}
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "capability"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "id": {"type": "string", "minLength": 1},
              "capability": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "agents"],
        "properties": {
          "stage": {"enum": ["DataLoad", "Alignment", "MapUpdate", "Save", "ApplyConfig"]},
          "agents": {
            "oneOf": [
              {"const": "all"},
              {"type": "array", "minItems": 1, "uniqueItems": true,
               "items": {"type": "string", "minLength": 1}}
            ]
          },
          "config_change": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "document"],
            "properties": {
              "domain": {
                "enum": [
                  "data_loader", "loop_detector", "optimizer",
                  "dynamic_remover", "map_save"
                ]
              },
              "document": {"$ref": "#/$defs/relative_path"},
              "selected_document": {"$ref": "#/$defs/relative_path"}
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": {"enum": ["success", "failure"]},
        "baseline_id": {"type": "string", "minLength": 1},
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "error_code", "revision_unchanged", "close_succeeds"],
          "properties": {
            "stage": {"enum": ["Open", "DataLoad", "Alignment", "MapUpdate", "Save", "ApplyConfig"]},
            "agent": {"type": "string", "minLength": 1},
            "error_code": {"type": "string", "minLength": 1},
            "revision_unchanged": {"type": "boolean"},
            "close_succeeds": {"type": "boolean"}
          }
        }
      }
    },
    "tolerances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.\\.?$).+$"
    },
    "file_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
