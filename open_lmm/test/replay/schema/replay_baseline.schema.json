{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-lmm.org/schemas/replay-baseline-v1.json",
  "title": "OpenLMM replay baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "baseline_id", "case_id", "case_manifest_sha256",
    "generator", "exact", "absolute_tolerances", "ranges"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generator": {"type": "object"},
    "exact": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pointer", "expected"],
        "properties": {
          "pointer": {"$ref": "#/$defs/pointer"},
          "expected": true
        }
      }
    },
    "absolute_tolerances": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pointer", "expected", "tolerance"],
        "properties": {
          "pointer": {"$ref": "#/$defs/pointer"},
          "expected": {"type": "number"},
          "tolerance": {"type": "number", "minimum": 0}
        }
      }
    },
    "ranges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pointer", "minimum", "maximum"],
        "properties": {
          "pointer": {"$ref": "#/$defs/pointer"},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "pointer": {"type": "string", "pattern": "^/.+"}
  }
}
