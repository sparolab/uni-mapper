{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-lmm.org/schemas/replay-report-v1.json",
  "title": "OpenLMM replay report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "case_manifest_sha256", "dataset_sha256",
    "config_sha256", "git", "environment", "agents", "steps", "health",
    "metrics", "artifacts", "diagnostics", "close_result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "environment": {"type": "object"},
    "agents": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "stage", "result", "error_code", "revision_before",
          "revision_after", "artifacts", "events"
        ],
        "properties": {
          "stage": {"enum": ["Open", "DataLoad", "Alignment", "MapUpdate", "Save", "ApplyConfig"]},
          "result": {"enum": ["succeeded", "failed", "cancelled"]},
          "error_code": {"type": ["string", "null"]},
          "revision_before": {"type": "integer", "minimum": 0},
          "revision_after": {"type": "integer", "minimum": 0},
          "artifacts": {"type": "array"},
          "events": {"type": "array"}
        }
      }
    },
    "health": {"type": "object"},
    "metrics": {"type": "object"},
    "artifacts": {"type": "array"},
    "diagnostics": {"type": "object"},
    "close_result": {"enum": ["succeeded", "failed"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}
  }
}
