{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-lmm.org/schemas/soak-bundle-v1.json",
  "title": "OpenLMM soak bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "profile", "iterations",
    "warmup_iterations", "seed", "git", "reports", "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["fast", "sanitizer", "nightly"]},
    "iterations": {"type": "integer", "minimum": 1},
    "warmup_iterations": {"type": "integer", "minimum": 0},
    "seed": {"type": "integer", "minimum": 0},
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "reports": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "soak_report.schema.json"}
    },
    "result": {"enum": ["pass", "fail"]}
  }
}
