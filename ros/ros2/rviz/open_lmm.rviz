Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: open_lmm_ros/OpenLmmControlPanel
    Name: OpenLMM Control
    Target Namespace: /open_lmm_ros
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 25; 179; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Map
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.01
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /open_lmm_ros/visualization/a_agent1/points
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 179; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.03
          Name: Path
          Offset: 0; 0; 0
          Pose Color: 25; 179; 255
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /open_lmm_ros/visualization/a_agent1/path
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Constraint
          Namespaces:
            open_lmm/inter_loop: true
            open_lmm/intra_loop: true
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /open_lmm_ros/visualization/loops
          Value: true
      Enabled: true
      Name: Agent1
      Value: true
